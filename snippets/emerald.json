{
  "Variable declaration": {
    "prefix": "var",
    "body": [
      "var ${1:name} = ${0:value}"
    ],
    "description": "Declare an inferred mutable variable"
  },
  "Constant declaration": {
    "prefix": "const",
    "body": [
      "const ${1:name} = ${0:value}"
    ],
    "description": "Declare an inferred constant"
  },
  "Struct declaration": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "\tvar ${2:field}: ${3:Type}",
      "\t$0",
      "}"
    ],
    "description": "Declare an Emerald value type"
  },
  "Class declaration": {
    "prefix": "class",
    "body": [
      "class ${1:Name}${2: extends Base} {",
      "\tvar ${3:field}: ${4:Type}",
      "\t$0",
      "}"
    ],
    "description": "Declare an Emerald reference type"
  },
  "Trait declaration": {
    "prefix": "trait",
    "body": [
      "trait ${1:Name} {",
      "\t${2:const name: String}",
      "\t$0",
      "}"
    ],
    "description": "Declare an Emerald trait"
  },
  "Enum declaration": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name} {",
      "\t${2:first_value}",
      "\t${3:second_value}",
      "\t$0",
      "}"
    ],
    "description": "Declare an Emerald enum"
  },
  "Function declaration": {
    "prefix": "func",
    "body": [
      "func ${1:name}(): ${2:Nothing} {",
      "\t$0",
      "}"
    ],
    "description": "Declare an Emerald function"
  },
  "If statement": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "\t$0",
      "}"
    ],
    "description": "Create a block-based if statement"
  },
  "While loop": {
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "\t$0",
      "}"
    ],
    "description": "Create a block-based while loop"
  },
  "For loop": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:items} {",
      "\t$0",
      "}"
    ],
    "description": "Iterate over an Emerald collection or range"
  },
  "Case statement": {
    "prefix": "case",
    "body": [
      "case ${1:subject} {",
      "\twhen ${2:value} {",
      "\t\t${3:body}",
      "\t}",
      "\telse {",
      "\t\t${4:body}",
      "\t}",
      "}",
      "$0"
    ],
    "description": "Create a case statement with a fallback arm"
  },
  "Try statement": {
    "prefix": "try",
    "body": [
      "try {",
      "\t${1:operation}",
      "}",
      "catch ${2:error}: ${3:Error} {",
      "\t${4:handle error}",
      "}",
      "finally {",
      "\t${5:cleanup}",
      "}",
      "$0"
    ],
    "description": "Handle an operation with catch and cleanup blocks"
  },
  "Lambda": {
    "prefix": "lambda",
    "body": [
      "{ ${1:value} => ${0:expression} }"
    ],
    "description": "Create a single-expression lambda"
  },
  "Test function": {
    "prefix": "test",
    "body": [
      "@test",
      "func ${1:name}() {",
      "\tassert ${0:condition}",
      "}"
    ],
    "description": "Declare an Emerald test function"
  },
  "Override method": {
    "prefix": "override",
    "body": [
      "@override",
      "func ${1:method}() {",
      "\t$0",
      "}"
    ],
    "description": "Override an inherited Emerald method"
  },
  "Abstract class": {
    "prefix": "abstract",
    "body": [
      "@abstract",
      "class ${1:Name} {",
      "\t@abstract",
      "\tfunc ${2:method}(): ${3:Type}",
      "\t$0",
      "}"
    ],
    "description": "Declare an abstract Emerald class"
  },
  "Constructor": {
    "prefix": "constructor",
    "body": [
      "constructor(${1:parameters}) {",
      "\t${2:self.field = value}",
      "\t$0",
      "}"
    ],
    "description": "Declare a custom Emerald constructor"
  },
  "Read-only property": {
    "prefix": "property",
    "body": [
      "const ${1:name}: ${2:Type} {",
      "\treturn ${0:expression}",
      "}"
    ],
    "description": "Declare a computed read-only property"
  },
  "Writable property": {
    "prefix": "property-set",
    "body": [
      "var ${1:name}: ${2:Type} {",
      "\tget {",
      "\t\treturn ${3:expression}",
      "\t}",
      "\tset {",
      "\t\t${4:self.field = value}",
      "\t}",
      "}"
    ],
    "description": "Declare a computed get/set property"
  },
  "Type-level function": {
    "prefix": "typefunc",
    "body": [
      "func ${1:Type}.${2:name}(): ${3:ReturnType} {",
      "\treturn ${0:value}",
      "}"
    ],
    "description": "Declare a function owned by an Emerald type"
  },
  "Function with defaults": {
    "prefix": "func-default",
    "body": [
      "func ${1:name}(${2:required}: ${3:Type}, ${4:optional}: ${5:Type} = ${6:default}): ${7:Nothing} {",
      "\t$0",
      "}"
    ],
    "description": "Declare an Emerald function with a default parameter"
  },
  "Raise error": {
    "prefix": "raise",
    "body": [
      "raise ${1:Error}(\"${0:message}\")"
    ],
    "description": "Raise a typed Emerald error"
  },
  "Try-finally statement": {
    "prefix": "try-finally",
    "body": [
      "try {",
      "\t${1:operation}",
      "}",
      "finally {",
      "\t${2:cleanup}",
      "}",
      "$0"
    ],
    "description": "Run cleanup after an operation completes or raises"
  },
  "File with open": {
    "prefix": "with-open",
    "body": [
      "File.with_open(\"${1:path}\") { ${2:file} =>",
      "\t${0:file.read()}",
      "}"
    ],
    "description": "Open a file and close it after the trailing block"
  },
  "Using namespace": {
    "prefix": "using",
    "body": [
      "using ${0:Namespace}"
    ],
    "description": "Shorten names from an Emerald namespace"
  },
  "Using alias": {
    "prefix": "using-alias",
    "body": [
      "using ${1:Alias} = ${0:Namespace.Name}"
    ],
    "description": "Alias an Emerald namespace or declaration"
  },
  "Named-argument call": {
    "prefix": "call-named",
    "body": [
      "${1:function}(${2:parameter}: ${0:value})"
    ],
    "description": "Call an Emerald function with a named argument"
  },
  "Method call": {
    "prefix": "method",
    "body": [
      "${1:receiver}.${2:method}(${0:arguments})"
    ],
    "description": "Call an Emerald method"
  },
  "Method chain": {
    "prefix": "chain",
    "body": [
      "${1:receiver}",
      "\t.${2:first_method}()",
      "\t.${3:next_method}()",
      "\t.${0:result}"
    ],
    "description": "Build a wrapped Emerald method chain"
  },
  "List literal": {
    "prefix": "list",
    "body": [
      "[${1:first}, ${2:second}${3:, ${4:third}}]$0"
    ],
    "description": "Create an Emerald list literal"
  },
  "List type": {
    "prefix": "type-list",
    "body": [
      "List[${0:Type}]"
    ],
    "description": "Write an Emerald list type"
  },
  "Dictionary type": {
    "prefix": "type-dict",
    "body": [
      "Dict[${1:Key}, ${0:Value}]"
    ],
    "description": "Write an Emerald dictionary type"
  },
  "Set type": {
    "prefix": "type-set",
    "body": [
      "Set[${0:Type}]"
    ],
    "description": "Write an Emerald set type"
  },
  "Dictionary literal": {
    "prefix": "dict",
    "body": [
      "[",
      "\t${1:key}: ${2:value},",
      "\t$0",
      "]"
    ],
    "description": "Create an Emerald dictionary literal"
  },
  "Set literal": {
    "prefix": "set",
    "body": [
      "var ${1:items}: {${2:Type}} = [",
      "\t${3:first},",
      "\t$0",
      "]"
    ],
    "description": "Create an Emerald set literal with an explicit type"
  },
  "Tuple literal": {
    "prefix": "tuple",
    "body": [
      "(${1:first}, ${2:second}${3:, ${4:third}})$0"
    ],
    "description": "Create an Emerald tuple literal"
  },
  "Range literal": {
    "prefix": "range",
    "body": [
      "${1:start}${2:..}${3:end}$0"
    ],
    "description": "Create an inclusive or exclusive Emerald range"
  },
  "If expression": {
    "prefix": "if-value",
    "body": [
      "if ${1:condition} then ${2:when_true} else ${0:when_false}"
    ],
    "description": "Choose a value with an Emerald if expression"
  },
  "Case expression": {
    "prefix": "case-value",
    "body": [
      "case ${1:subject} {",
      "\twhen ${2:first_value} then ${3:first_result}",
      "\twhen ${4:second_value} then ${5:second_result}",
      "\telse then ${0:default_result}",
      "}"
    ],
    "description": "Choose a value with an exhaustive Emerald case expression"
  }
}
